# Development only. Never place production secrets in this file.
NODE_ENV=development

# API
API_PORT=4000
API_HOST=127.0.0.1
CORS_ORIGIN=http://localhost:3000

# Database (Phase 2)
DATABASE_URL=postgresql://devarena:devarena@localhost:5432/devarena
DEV_SEED_ADMIN_PASSWORD=
DEV_SEED_USER_PASSWORD=

# Sessions & Authentication (Phase 3)
SESSION_SECRET=replace-with-a-local-development-secret
SESSION_COOKIE_NAME=devarena_session
SESSION_TTL_SECONDS=604800
TRUST_PROXY=false
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_REGISTER_RATE_LIMIT_MAX=5
AUTH_LOGIN_RATE_LIMIT_MAX=10

# AWS / Judge infrastructure (Phase 7+)
AWS_REGION=ap-south-1
SQS_QUEUE_URL=
SQS_DLQ_URL=
S3_BUCKET=

# Judge worker runtime (Phase 7+)
WORKER_CONCURRENCY=2
WORKER_POLL_WAIT_SECONDS=20
WORKER_HEALTH_PORT=4001

# Browser-visible API origin
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
