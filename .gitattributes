# Normalize line endings to LF across all platforms (Windows, macOS, Linux)
* text=auto eol=lf

# Explicitly enforce LF on source, config, SQL, shell, and documentation files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.prisma text eol=lf
*.sql text eol=lf
*.toml text eol=lf
*.css text eol=lf
*.sh text eol=lf

# Windows scripts if ever added
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.zip binary
